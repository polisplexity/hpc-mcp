{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polisplexity HPC job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtime", "entrypoint", "argv", "inputs", "outputs", "resources"],
  "properties": {
    "version": {"const": "polisplexity.hpc.job.v1"},
    "runtime": {"enum": ["python3", "rscript"]},
    "output_mode": {"const": "reference"},
    "entrypoint": {"$ref": "#/$defs/path"},
    "argv": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$"}
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64},
          "source": {"$ref": "#/$defs/path"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 33554432}
        },
        "dependentRequired": {
          "source": ["size_bytes"],
          "size_bytes": ["source"]
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpus", "memory_mib", "wall_time_seconds"],
      "properties": {
        "cpus": {"type": "integer", "minimum": 1, "maximum": 4},
        "memory_mib": {"type": "integer", "minimum": 64, "maximum": 1024},
        "wall_time_seconds": {"type": "integer", "minimum": 1, "maximum": 30}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"runtime": {"const": "rscript"}}},
      "then": {"properties": {"entrypoint": {"pattern": "\\.R$"}}},
      "else": {
        "not": {"required": ["output_mode"]},
        "properties": {
          "entrypoint": {"pattern": "\\.py$"},
          "inputs": {"items": {"not": {"required": ["source"]}}}
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(/[A-Za-z0-9][A-Za-z0-9_.-]{0,63})*$"
    }
  }
}
